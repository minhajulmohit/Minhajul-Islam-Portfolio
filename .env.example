# Resend (https://resend.com) API key used by the contact form.
RESEND_API_KEY=re_your_api_key_here

# Verified sender address.
# With a verified domain: Portfolio Contact <contact@your-domain.com>
# Without a domain, Resend test mode only accepts onboarding@resend.dev and
# only delivers to the email that owns the Resend account.
RESEND_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"

# Where contact form messages are delivered.
CONTACT_TO_EMAIL=minhajul.mohit@gmail.com
